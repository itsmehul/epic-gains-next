DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Public origin clients hit (set both BETTER_AUTH_URL and this to your ngrok HTTPS URL for MCP OAuth tests).
# Dev auth accepts localhost + LAN IPs dynamically; keep these as localhost unless you need ngrok for MCP.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth stubs — set both to enable Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI SDK (OpenRouter — used for Gemini)
# OPENROUTER_API_KEY=

# LangSmith tracing (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# LANGSMITH_PROJECT=epic-gains-next

# MCP reliability script (pnpm ai:test-mcp)
# MCP_URL=http://localhost:3000/api/mcp
# MCP_API_KEY=

# Email stub (Resend-shaped)
# RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Storage stub (S3-compatible)
# S3_BUCKET=
S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
